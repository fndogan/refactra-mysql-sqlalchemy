# =============================================================================
# Refactra: MySQL to SQLAlchemy configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Source Configuration ---
# Directories containing Python files with raw SQL (comma-separated for multiple)
SOURCE_DIR=./path/to/queries,./path/to/utils,./path/to/routes

# Path to your SQLAlchemy models file (generated by sqlacodegen or hand-written)
MODELS_FILE=./path/to/your/models.py

# --- Output Configuration ---
# Directory where converted files will be written
OUTPUT_DIR=./output

# Directory for generated analysis and conversion reports
REPORTS_DIR=./reports

# Set to "true" to preview changes without writing files
DRY_RUN=false

# --- AI Provider Configuration ---
# Provider: "anthropic" (Claude) or "openai" (GPT)
AI_PROVIDER=anthropic

# Your API key (required only for AI-assisted conversion)
AI_API_KEY=your-api-key-here

# Required model identifier. Copy a currently supported ID from your
# provider's official model documentation; model IDs are intentionally not
# hardcoded by this project.
AI_MODEL=

# Optional local prompt overrides. Keep private prompts outside version control.
SYSTEM_PROMPT_FILE=
DYNAMIC_PROMPT_FILE=

# Enable prompt caching (reduces cost for repeated context like models.py)
# Only supported by Anthropic Claude
AI_PROMPT_CACHING=true

# --- Rate Limiting ---
# Match these values to the limits displayed in your provider dashboard.
RATE_LIMIT_RPM=5
RATE_LIMIT_INPUT_TPM=10000
RATE_LIMIT_OUTPUT_TPM=4000

# Retry settings for transient API errors
MAX_RETRIES=3
RETRY_DELAY=5.0

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (leave empty for stdout only)
LOG_FILE=./logs/migration.log
